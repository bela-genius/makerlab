# Copiar este archivo como .env (misma carpeta) y poner los valores reales.
# El archivo .env NUNCA se sube a Git ni a la imagen Docker (está en .gitignore y .dockerignore).

# --- Opción A (local, como en la entrega original) ---
DB_URL=jdbc:postgresql://localhost:5432/makerlab_poo
DB_USER=postgres
DB_PASSWORD=escriba_aqui_su_clave

# --- Opción B (nube: Neon / Supabase / Render). Tiene prioridad sobre la opción A. ---
# En producción NO se escribe aquí: se define como secreto en el proveedor.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# --- Versión web ---
# Clave del botón "Modo demostración" (sin ella el botón queda desactivado).
# DEMO_TOKEN=cambie_esta_clave
# Puerto HTTP (Render lo define solo). Por defecto 8080.
# PORT=8080
